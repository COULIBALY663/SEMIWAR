NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=appel
DB_PASSWORD=appel
DB_NAME=appel_sewimar
DB_SSL=false

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Fournisseur SMS : auto | orange | twilio | simulation
# auto = Orange si configuré, sinon Twilio, sinon simulation (aucun envoi réel)
SMS_PROVIDER=auto
SMS_INDICATIF_PAYS=225

# Orange Developer - API "SMS Côte d'Ivoire" (https://developer.orange.com/apis/sms-ci)
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
# Adresse expéditeur imposée par Orange (CI : tel:+2250000)
ORANGE_SENDER_ADDRESS=tel:+2250000
# Nom affiché (optionnel, doit être validé par Orange)
ORANGE_SENDER_NAME=

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro Twilio (+1...) ou identifiant alphanumérique (ex. SEWIMAR)
TWILIO_FROM_NUMBER=
# Alternative à TWILIO_FROM_NUMBER
TWILIO_MESSAGING_SERVICE_SID=

SEUIL_ABSENCES_SIGNALEMENT=4
